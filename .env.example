# Postgres connection string.
#
# Get a free one at https://neon.com (no credit card, no expiry):
#   1. Sign up and create a project
#   2. Copy the connection string from the dashboard
#   3. Paste it below, and set the same value in Render's Environment tab
#
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Port for local development (Render sets this automatically)
PORT=5000
